{
  "name": "jarvix",
  "version": "0.1.0",
  "description": "Jarvix desktop app",
  "author": "QingKong996 <qingkong996@gmail.com>",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "headless": "npm run build 1>&2 && electron . --headless",
    "build": "npm run typecheck && electron-vite build",
    "start": "npm run build && electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:mcp": "vitest run src/mcp/runtime.integration.test.ts",
    "report:agent": "node --disable-warning=ExperimentalWarning scripts/agent-report.mjs",
    "test:ui": "node scripts/run-bombadil.mjs",
    "test:ui:check": "tsc -p tests/bombadil/tsconfig.json --noEmit",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "0.7.10",
    "@dnd-kit/core": "^6.3.1",
    "@lobehub/icons-static-svg": "1.102.0",
    "@modelcontextprotocol/server-everything": "1.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "i18next": "^27.1.0",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-resizable-panels": "^4.19.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.83",
    "@earendil-works/pi-ai": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-document": "^3.35.0",
    "@tiptap/extension-hard-break": "^3.35.0",
    "@tiptap/extension-history": "^3.35.0",
    "@tiptap/extension-paragraph": "^3.35.0",
    "@tiptap/extension-text": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@types/js-yaml": "^4.0.9",
    "electron-log": "^5.4.4",
    "js-yaml": "^5.5.0",
    "motion": "^14.14.0",
    "streamdown": "^2.7.1",
    "zod": "^4.6.7"
  }
}
